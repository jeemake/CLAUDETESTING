{
  "name": "WhatsApp Draft Replies",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-webhook",
        "options": {
          "rawBody": true
        },
        "responseMode": "responseNode"
      },
      "id": "webhook-trigger",
      "name": "WhatsApp Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "whatsapp-incoming"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-has-messages",
              "leftValue": "={{ $json.body.entry[0].changes[0].value.messages }}",
              "rightValue": "",
              "operator": {
                "type": "exists",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-messages",
      "name": "Filter Incoming Messages",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst entry = body.entry[0];\nconst change = entry.changes[0].value;\nconst message = change.messages[0];\nconst contact = change.contacts[0];\n\nreturn [{\n  json: {\n    phoneNumberId: change.metadata.phone_number_id,\n    from: message.from,\n    senderName: contact.profile.name,\n    messageId: message.id,\n    timestamp: message.timestamp,\n    messageType: message.type,\n    messageText: message.type === 'text' ? message.text.body : `[${message.type} message]`,\n  }\n}];\n"
      },
      "id": "extract-message",
      "name": "Extract Message Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"system\": \"You are a helpful assistant that drafts WhatsApp reply messages. Write concise, friendly, and appropriate responses. Match the tone and language of the incoming message. Keep replies short and conversational, as is typical for WhatsApp. Only return the draft reply text, nothing else.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Draft a reply to this WhatsApp message from {{ $json.senderName }}:\\n\\n{{ $json.messageText }}\"\n    }\n  ]\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "generate-draft",
      "name": "Generate Draft Reply (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst draftReply = input.content[0].text;\nconst prevData = $('Extract Message Details').first().json;\n\nreturn [{\n  json: {\n    from: prevData.from,\n    senderName: prevData.senderName,\n    originalMessage: prevData.messageText,\n    draftReply: draftReply,\n    phoneNumberId: prevData.phoneNumberId,\n    messageId: prevData.messageId,\n    timestamp: prevData.timestamp,\n    status: 'draft',\n    generatedAt: new Date().toISOString()\n  }\n}];\n"
      },
      "id": "format-draft",
      "name": "Format Draft Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.phoneNumberId }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"status\": \"read\",\n  \"message_id\": \"{{ $json.messageId }}\"\n}",
        "options": {}
      },
      "id": "mark-read",
      "name": "Mark Message as Read",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Format Draft Response').first().json.phoneNumberId }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Format Draft Response').first().json.from }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"preview_url\": false,\n    \"body\": \"{{ $('Format Draft Response').first().json.draftReply }}\"\n  }\n}",
        "options": {}
      },
      "id": "send-draft",
      "name": "Send Draft to Self",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "disabled": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\": \"draft_generated\", \"from\": \"{{ $('Format Draft Response').first().json.senderName }}\", \"original\": \"{{ $('Format Draft Response').first().json.originalMessage }}\", \"draft\": \"{{ $('Format Draft Response').first().json.draftReply }}\" }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "webhook-response-ok",
      "name": "Respond With Draft",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\": \"ignored\", \"reason\": \"no_messages\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "webhook-response-ignored",
      "name": "Acknowledge (No Message)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 400]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-webhook",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-verify",
      "name": "WhatsApp Verification (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 520],
      "webhookId": "whatsapp-verify"
    },
    {
      "parameters": {
        "jsCode": "const query = $input.first().json.query;\nconst mode = query['hub.mode'];\nconst token = query['hub.verify_token'];\nconst challenge = query['hub.challenge'];\n\nconst VERIFY_TOKEN = $env.WHATSAPP_VERIFY_TOKEN || 'my-verify-token';\n\nif (mode === 'subscribe' && token === VERIFY_TOKEN) {\n  return [{ json: { challenge: parseInt(challenge) } }];\n}\n\nreturn [{ json: { error: 'Verification failed' } }];\n"
      },
      "id": "verify-token",
      "name": "Verify Webhook Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 520]
    }
  ],
